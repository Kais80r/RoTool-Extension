{
  "manifest_version": 3,
  "name": "RoTool",
  "short_name": "RoTool",
  "version": "0.17.6",
  "description": "Configurable Server History, Quick Settings, Player Counts, Quick Play, Random Server, Private Servers, Best Friends & ID copying.",
  "permissions": [
    "storage",
    "alarms",
    "contextMenus",
    "clipboardWrite",
    "scripting"
  ],
  "icons": {
    "16": "icons/rotool-16.png",
    "32": "icons/rotool-32.png",
    "48": "icons/rotool-48.png",
    "128": "icons/rotool-128.png"
  },
  "host_permissions": [
    "https://www.roblox.com/*",
    "https://thumbnails.roblox.com/*",
    "https://friends.roblox.com/*",
    "https://users.roblox.com/*",
    "https://presence.roblox.com/*",
    "https://games.roblox.com/*",
    "https://apis.roblox.com/*",
    "https://economy.roblox.com/*",
    "https://assetdelivery.roblox.com/*",
    "https://*.rbxcdn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.roblox.com/*",
        "https://create.roblox.com/*"
      ],
      "css": [
        "context-copy.css"
      ],
      "js": [
        "context-copy.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
